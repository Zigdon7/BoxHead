        "name": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/RaidResult"
        },
        "extractName": {
          "type": "string"
        },
        "killedBy": {
          "$ref": "#/$defs/ZombieType"
        },
        "loot": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "bounty": {
          "type": "number"
        },
        "kills": {
          "type": "number"
        },
        "maxCombo": {
          "type": "number"
        },
        "survivedSecs": {
          "type": "number"
        },
        "lost": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        }
      },
      "required": [
        "playerId",
        "name",
        "result",
        "loot",
        "bounty",
        "kills",
        "maxCombo",
        "survivedSecs",
        "lost"
      ]
    },
    "RaidSettlement": {
      "type": "object",
      "properties": {
        "cashEarned": {
          "type": "number"
        },
        "itemsKept": {
          "type": "number"
        },
        "itemsAutoSold": {
          "type": "number"
        },
        "cash": {
          "type": "number"
        },
        "insured": {
          "type": "boolean"
        },
        "bonusCash": {
          "type": "number",
          "description": "Extra cash from Operations rank, perks and the season boost (already in cashEarned)."
        },
        "ops": {
          "$ref": "#/$defs/OpsProgress"
        }
      },
      "required": [
        "cashEarned",
        "itemsKept",
        "itemsAutoSold",
        "cash",
        "insured",
        "bonusCash"
      ]
    },
    "RaidEnd": {
      "type": "object",
      "properties": {
        "type": {
          "const": "raidEnd"
        },
        "map": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/RaidOutcome"
        },
        "settlement": {
          "oneOf": [
            {
              "$ref": "#/$defs/RaidSettlement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "map",
        "outcome"
      ]
    },
    "OpsProgress": {
      "type": "object",
      "description": "Operations progress on the raided map after a raid.",
      "properties": {
        "map": {
          "type": "string"
        },
        "xpGained": {
          "type": "number"
        },
        "xp": {
          "type": "number"
        },
        "rank": {
          "type": "number"
        },
        "rankedUp": {
          "type": "boolean"
        },
        "next": {
          "type": [
            "number",
            "null"
          ],
          "description": "XP needed for the next rank (null at the top)."
        }
      },
      "required": [
        "map",
        "xpGained",
        "xp",
        "rank",
        "rankedUp",
        "next"
      ]
    }
  }
