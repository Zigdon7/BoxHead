          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "tier",
        "minGearScore",
        "raidSecs"
      ]
    },
    "RaidResult": {
      "type": "string",
      "enum": [
        "extracted",
        "killed",
        "missingInAction",
        "abandoned"
      ]
    },
    "RaidOutcome": {
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string"
