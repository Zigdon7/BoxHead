    "ItemKind": {
      "type": "string",
      "enum": [
        "pistol",
        "uzi",
        "shotgun",
        "rocketLauncher",
        "armor",
        "pack",
        "valuable",
        "encrypted"
      ]
    },
    "Rarity": {
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary"
      ]
    },
    "Slot": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "armor",
        "pack"
      ]
