    "ZombieDelta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "pos": {
          "$ref": "#/$defs/Vector2"
        },
        "health": {
          "type": "number"
        }
      },
      "required": [
        "id"
      ]
