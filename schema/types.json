        },
        "gearScore": {
          "type": "number"
        },
        "raidTime": {
          "type": "number"
        },
        "extractProgress": {
          "type": "number"
        },
        "bleedout": {
          "type": "number"
        },
        "camp": {
          "type": "number"
        },
        "hunted": {
          "type": "boolean"
        },
        "damageLog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DamageHit"
          }
        },
        "decrypt": {
          "type": "number"
        }
      },
      "required": [
        "id"
      ]
