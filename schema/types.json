        "ammoPickups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AmmoPickupState"
          }
        },
        "crates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AmmoPickupState"
          }
        }
      },
      "required": [
        "type",
