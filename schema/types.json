        "players": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PlayerDelta"
          }
        },
        "playersRemoved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "zombiesNew": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Zombie"
          }
        },
        "zombiesUpdated": {
          "type": "array",
