{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boxhead-types",
  "$defs": {
    "Vector2": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["x", "y"]
    },
    "Weapon": {
      "type": "string",
      "enum": ["pistol", "uzi", "shotgun", "rocketLauncher"]
    },
    "DropType": {
      "type": "string",
      "enum": ["ammo", "health", "weapon", "tactical"]
    },
    "PlaceableType": {
      "type": "string",
      "enum": ["barrel", "barricade", "mine"]
    },
    "Placeable": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/PlaceableType" },
        "pos": { "$ref": "#/$defs/Vector2" },
        "health": { "type": "number" },
        "maxHealth": { "type": "number" },
        "ownerId": { "type": "string" }
      },
      "required": ["id", "type", "pos", "health", "maxHealth", "ownerId"]
    },
    "PlaceableDelta": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "health": { "type": "number" }
      },
      "required": ["id"]
    },
    "DropPickup": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/DropType" },
        "pos": { "$ref": "#/$defs/Vector2" }
      },
      "required": ["id", "type", "pos"]
    },
    "ZombieType": {
      "type": "string",
      "enum": ["zombie", "devil", "crawler", "brute", "vampire"]
    },
    "Player": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "pos": { "$ref": "#/$defs/Vector2" },
        "angle": { "type": "number" },
        "score": { "type": "number" },
        "credits": { "type": "number" },
        "health": { "type": "number" },
        "maxHealth": { "type": "number" },
        "ammo": { "type": "number" },
        "maxAmmo": { "type": "number" },
        "weapon": { "$ref": "#/$defs/Weapon" },
        "weaponSlots": { "type": "array", "items": { "type": "boolean" }, "minItems": 4, "maxItems": 4 },
        "combo": { "type": "number" },
        "comboTimer": { "type": "number" },
        "maxCombo": { "type": "number" },
        "kills": { "type": "number" },
        "tacticalItems": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "damageLevel": { "type": "number" },
        "meleeLevel": { "type": "number" }
      },
      "required": ["id", "name", "pos", "angle", "score", "credits", "health", "maxHealth", "ammo", "maxAmmo", "weapon", "weaponSlots", "combo", "comboTimer", "maxCombo", "kills", "tacticalItems", "damageLevel", "meleeLevel"]
    },
    "Zombie": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/ZombieType" },
        "pos": { "$ref": "#/$defs/Vector2" },
        "health": { "type": "number" },
        "maxHealth": { "type": "number" },
        "speed": { "type": "number" }
      },
      "required": ["id", "type", "pos", "health", "maxHealth", "speed"]
    },
    "Bullet": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pos": { "$ref": "#/$defs/Vector2" },
        "vel": { "$ref": "#/$defs/Vector2" },
        "ownerId": { "type": "string" },
        "damage": { "type": "number" },
        "isCrit": { "type": "boolean" },
        "isRocket": { "type": "boolean" }
      },
      "required": ["id", "pos", "vel", "ownerId", "damage"]
    },
    "Wall": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" }
      },
      "required": ["x", "y", "w", "h"]
    },
    "AmmoSpawnPoint": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "amount": { "type": "number" }
      },
      "required": ["x", "y", "amount"]
    },
    "AmmoPickupState": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "available": { "type": "boolean" }
      },
      "required": ["id", "available"]
    },
    "ClientInput": {
      "type": "object",
      "properties": {
        "up": { "type": "boolean" },
        "down": { "type": "boolean" },
        "left": { "type": "boolean" },
        "right": { "type": "boolean" },
        "mouseX": { "type": "number" },
        "mouseY": { "type": "number" },
        "shooting": { "type": "boolean" },
        "melee": { "type": "boolean" },
        "selectWeapon": { "type": "number" },
        "dash": { "type": "boolean" },
        "placeItem": { "type": "number" },
        "buyUpgrade": { "type": "number" }
      },
      "required": ["up", "down", "left", "right", "mouseX", "mouseY", "shooting", "melee", "selectWeapon"]
    },
    "InitPayload": {
      "type": "object",
      "properties": {
        "type": { "const": "init" },
        "id": { "type": "string" },
        "walls": { "type": "array", "items": { "$ref": "#/$defs/Wall" } },
        "mapWidth": { "type": "number" },
        "mapHeight": { "type": "number" },
        "ammoSpawnPoints": { "type": "array", "items": { "$ref": "#/$defs/AmmoSpawnPoint" } },
        "gameOver": { "type": "boolean" },
        "wave": { "type": "number" }
      },
      "required": ["type", "id", "walls", "mapWidth", "mapHeight", "ammoSpawnPoints"]
    },
    "SnapshotState": {
      "type": "object",
      "properties": {
        "type": { "const": "snapshot" },
        "tick": { "number": "number" },
        "players": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Player" }
        },
        "zombies": { "type": "array", "items": { "$ref": "#/$defs/Zombie" } },
        "bullets": { "type": "array", "items": { "$ref": "#/$defs/Bullet" } },
        "placeables": { "type": "array", "items": { "$ref": "#/$defs/Placeable" } },
        "wave": { "type": "number" },
        "waveKills": { "type": "number" },
        "waveTarget": { "type": "number" },
        "waveBreakTimer": { "type": "number" },
        "ammoPickups": { "type": "array", "items": { "$ref": "#/$defs/AmmoPickupState" } },
        "drops": { "type": "array", "items": { "$ref": "#/$defs/DropPickup" } },
        "gameOver": { "type": "boolean" }
      },
      "required": ["type", "tick", "players", "zombies", "bullets", "placeables", "wave", "waveKills", "waveTarget", "waveBreakTimer", "ammoPickups", "drops", "gameOver"]
    },
    "PlayerDelta": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "pos": { "$ref": "#/$defs/Vector2" },
        "angle": { "type": "number" },
        "score": { "type": "number" },
        "credits": { "type": "number" },
        "health": { "type": "number" },
        "maxHealth": { "type": "number" },
        "ammo": { "type": "number" },
        "maxAmmo": { "type": "number" },
        "weapon": { "$ref": "#/$defs/Weapon" },
        "weaponSlots": { "type": "array", "items": { "type": "boolean" }, "minItems": 4, "maxItems": 4 },
        "combo": { "type": "number" },
        "comboTimer": { "type": "number" },
        "maxCombo": { "type": "number" },
        "kills": { "type": "number" },
        "tacticalItems": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "damageLevel": { "type": "number" },
        "meleeLevel": { "type": "number" }
      },
      "required": ["id"]
    },
    "ZombieDelta": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pos": { "$ref": "#/$defs/Vector2" },
        "health": { "type": "number" }
      },
      "required": ["id"]
    },
    "DeltaState": {
      "type": "object",
      "properties": {
        "type": { "const": "delta" },
        "tick": { "type": "number" },
        "players": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/PlayerDelta" }
        },
        "playersRemoved": { "type": "array", "items": { "type": "string" } },
        "zombiesNew": { "type": "array", "items": { "$ref": "#/$defs/Zombie" } },
        "zombiesUpdated": { "type": "array", "items": { "$ref": "#/$defs/ZombieDelta" } },
        "zombiesRemoved": { "type": "array", "items": { "type": "string" } },
        "bulletsNew": { "type": "array", "items": { "$ref": "#/$defs/Bullet" } },
        "bulletsRemoved": { "type": "array", "items": { "type": "string" } },
        "placeablesNew": { "type": "array", "items": { "$ref": "#/$defs/Placeable" } },
        "placeablesUpdated": { "type": "array", "items": { "$ref": "#/$defs/PlaceableDelta" } },
        "placeablesRemoved": { "type": "array", "items": { "type": "string" } },
        "dropsNew": { "type": "array", "items": { "$ref": "#/$defs/DropPickup" } },
        "dropsRemoved": { "type": "array", "items": { "type": "string" } },
        "wave": { "type": "number" },
        "waveKills": { "type": "number" },
        "waveTarget": { "type": "number" },
        "waveBreakTimer": { "type": "number" },
        "ammoPickups": { "type": "array", "items": { "$ref": "#/$defs/AmmoPickupState" } },
        "gameOver": { "type": "boolean" }
      },
      "required": ["type", "tick"]
    }
  }
}
