          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "placeablesNew": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Placeable"
          }
        },
        "placeablesUpdated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaceableDelta"
          }
        },
        "placeablesRemoved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dropsNew": {
          "type": "array",
