# Copy to .env and fill in. `docker compose` reads it; never commit the real one.

# ---- Required ----

# The public address players use. Email links and Steam sign-in are built from it.
BASE_URL=https://play.example.com

# Shared secret between the game server and the dashboard:  openssl rand -hex 24
BOXHEAD_OPS_TOKEN=

# Password for the ops dashboard (any user name works).
DASHBOARD_PASSWORD=

# ---- Getting players in: pick one (docs/HOSTING.md) ----

# Option A, Cloudflare Tunnel: the token from Zero Trust > Networks > Tunnels.
TUNNEL_TOKEN=

# Option B, Caddy with port forwarding: the domain that points at your home address.
DOMAIN=play.example.com

# ---- Email (confirmation and password-reset links) ----
# Any SMTP provider works. Without SMTP_HOST the links are only printed to the
# server log, so new email sign-ups can't confirm on their own.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=BoxHead <no-reply@example.com>

# ---- Optional sign-in providers ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STEAM_API_KEY=

# ---- Optional tuning ----

# Where the game and the dashboard listen on this machine. 127.0.0.1 = this
# machine only; 0.0.0.0 = your whole LAN.
GAME_BIND=127.0.0.1
GAME_PORT=3001
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=3900

# Backups: a folder on this machine or a mounted NAS share (it must be writable
# by user id 10001). Left unset, backups go to a Docker volume on the same disk.
#BACKUP_DIR=/mnt/nas/boxhead-backups
BACKUP_EVERY_HOURS=6
BACKUP_KEEP_DAYS=14

# Simulation threads (default: one per CPU core) and the most raids at once.
#BOXHEAD_SIM_THREADS=4
#BOXHEAD_MAX_ROOMS=256

# Raidable operators. Leave off until PvP exists.
#BOXHEAD_PVP=1
